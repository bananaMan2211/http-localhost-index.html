        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = i
        lbl.Parent = ActiveList
    end
end
local function setActive(feature, state)
    if state then
        table.insert(activeFeatures, feature)
    else
        for i, f in pairs(activeFeatures) do
            if f == feature then table.remove(activeFeatures, i) break end
        end
    end
    updateActiveList()
end

